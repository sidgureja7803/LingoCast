# Lingo.dev API key (used by both Compiler and SDK)
# Get your key at: https://lingo.dev
LINGODOTDEV_API_KEY=your_lingodotdev_api_key_here

# Lingo.dev SDK key (used for runtime chapter translations)
LINGO_API_KEY=your_lingo_api_key_here

# OpenRouter API key (used for AI summarization)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Google Gemini API key (used for text-to-speech)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Public app URL for SEO metadata
# NEXT_PUBLIC_APP_URL=https://lingocast.vercel.app
